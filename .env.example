# Aiven Console -> your service -> Overview: bootstrap server
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=YOUR_KAFKA_USERNAME
KAFKA_SASL_PASSWORD=YOUR_KAFKA_PASSWORD
KAFKA_SSL_TRUSTSTORE_LOCATION=cert/client.truststore.p12
KAFKA_SSL_TRUSTSTORE_PASSWORD=YOUR_KAFKA_PASSWORD
KAFKA_BOOTSTRAP_SERVERS=YOUR_HOST:YOUR_PORT
# Database defaults match docker-compose.yml; change for non-local DB
#DB_URL=jdbc:postgresql://localhost:5432/eventguard
DB_URL=jdbc:postgresql://YOUR_DB_HOST:YOUR_DB_PORT/DB_NAME
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

SERVER_PORT=8080
KAFKA_CONSUMER_GROUP=eventguard-processor